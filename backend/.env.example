# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (Neon PostgreSQL) ───────────────────────────
DATABASE_URL=postgresql://neondb_owner:npg_8FxyTVjeo3Dt@ep-steep-moon-b55zp83t-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── Frontend URL (CORS) ──────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── LLM Provider  (pick one) ────────────────────────────
# Groq (recommended — free tier, fast)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# Active provider: groq | openai | gemini | mock
LLM_PROVIDER=mock

# ─── Excel File Paths ─────────────────────────────────────
HRMS_EXCEL_PATH=./data/hrms.xlsx
FINANCE_EXCEL_PATH=./data/finance.xlsx

# ─── WhatsApp Mock API ────────────────────────────────────
WHATSAPP_API_URL=https://api.mock-whatsapp.example.com
WHATSAPP_API_TOKEN=mock_token_here
WHATSAPP_FROM_NUMBER=+911234567890

# ─── Policy Limits ────────────────────────────────────────
MAX_TRIP_BUDGET_EMPLOYEE=50000
MAX_TRIP_BUDGET_MANAGER=150000
MAX_TRIP_BUDGET_EXECUTIVE=500000

# ─── Brevo Email API (OTP) ─────────────────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@example.com
BREVO_SENDER_NAME=AeroSync CTM

# ─── Brevo SMTP Relay Settings ─────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b38b94001@smtp-brevo.com
SMTP_PASSWORD=your_smtp_key_or_password_here
